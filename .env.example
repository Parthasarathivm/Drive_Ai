# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- AI provider (optional; server-side only). Set ONE of these. ---
# AI_PROVIDER=gemini            # gemini | claude (auto-detected from whichever key is set)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=                     # optional override (defaults: gemini-2.0-flash / claude-sonnet-4-5)

# --- Security / deployment ---
# SESSION_COOKIE_SECURE=true    # set when serving over HTTPS
# AUTH_SHOW_RESET_LINK=true     # DEV ONLY: return password-reset link in API response (no email provider yet)
